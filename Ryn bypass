-- 3. COMBO LOGIC (V5.0)
---------------------------------------------------------
local autoPunchSkillActive = false
local autoPunchSkillThread = nil

AutoPunchSkillBtn.MouseButton1Click:Connect(function()
    autoPunchSkillActive = not autoPunchSkillActive
    if autoPunchSkillActive then
        AutoPunchSkillBtn.Text = "🎯 Auto Combo 3-4: ON"
        AutoPunchSkillBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        
        autoPunchSkillThread = task.spawn(function()
            while autoPunchSkillActive do
                task.wait(0.1)
                local targetChar, targetHum = getClosestTarget()
                if targetChar and targetHum then
                    clickMouse()
                    task.wait(0.05)
                    pressKey(Enum.KeyCode.Three)
                    task.wait(0.5)
                    
                    if targetHum and targetHum.Health > 0 then
                        clickMouse()
                        task.wait(0.05)
                        pressKey(Enum.KeyCode.Four)
                        task.wait(0.5)
                    end
                    task.wait(3)
                end
            end
        end)
    else
        AutoPunchSkillBtn.Text = "🎯 Auto Combo 3-4: OFF"
        AutoPunchSkillBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if autoPunchSkillThread then
            task.cancel(autoPunchSkillThread)
            autoPunchSkillThread = nil
        end
    end
end)

