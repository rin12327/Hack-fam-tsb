-- FREEZE AUTO DIE (TRỤC Y = -500 SÂU NHẤT)
local isAutoDieFrozen = false
local autoDieConnection = nil
local healthConn = nil
local lastHealth = 100
local isDying = false

local function triggerInstantVoidDeath()
    if isDying then return end
    isDying = true
    
    local char = LocalPlayer.Character
    if char then
        pcall(function()
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            Camera.CameraSubject = nil
            
            for _, child in ipairs(char:GetDescendants()) do
                if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("BodyVelocity") or child:IsA("BodyPosition") then
                    child:Destroy()
                end
            end
            
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                hrp.CFrame = CFrame.new(hrp.Position.X, -500, hrp.Position.Z)
            end
            
            if hum then hum.Health = 0 end
            char:BreakJoints()
        end)
    end
end

local function setupHealthTracker(char)
    if healthConn then healthConn:Disconnect() healthConn = nil end
    if not char then return end
    
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        lastHealth = hum.Health
        healthConn = hum.HealthChanged:Connect(function(newHealth)
            if isAutoDieFrozen and newHealth < lastHealth then
                triggerInstantVoidDeath()
            end
            lastHealth = newHealth
        end)
    end
end

FreezeAutoDieBtn.MouseButton1Click:Connect(function()
    isAutoDieFrozen = not isAutoDieFrozen
    if isAutoDieFrozen then
        FreezeAutoDieBtn.Text = "💀 Freeze + Die: ON"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        isDying = false
        
        setupHealthTracker(LocalPlayer.Character)
        if autoDieConnection then autoDieConnection:Disconnect() end
        
        autoDieConnection = RunService.RenderStepped:Connect(function()
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("HumanoidRootPart") and curChar:FindFirstChild("Humanoid") then
                local hum = curChar.Humanoid
                local hrp = curChar.HumanoidRootPart
                
                if hum.Health < lastHealth then
                    triggerInstantVoidDeath()
                end
                
                if curChar:FindFirstChild("Ragdoll") or curChar:FindFirstChild("Stun") 
                    or curChar:FindFirstChild("Knockback") or curChar:FindFirstChild("Grabbed") 
                    or curChar:FindFirstChild("BeingGrabbed") then
                    triggerInstantVoidDeath()
                end

                if not isDying then
                    hrp.CFrame = targetCFrame1
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    else
        FreezeAutoDieBtn.Text = "💀 Freeze + Die: OFF"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        isDying = false
        if healthConn then healthConn:Disconnect() healthConn = nil end
        if autoDieConnection then autoDieConnection:Disconnect() autoDieConnection = nil end
    end
end)

