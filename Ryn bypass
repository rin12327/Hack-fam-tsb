-- 3A. LOGIC NÚT 2: FREEZE + AUTO DIE (NÚT CỦ)
---------------------------------------------------------
local isAutoDieFrozen = false
local autoDieConnection = nil
local hitDetector = nil
local isDying = false

local function triggerKillCreditDeath()
    if isDying then return end
    isDying = true

    if autoDieConnection then
        autoDieConnection:Disconnect()
        autoDieConnection = nil
    end

    task.wait(0.02)

    local char = LocalPlayer.Character
    if char then
        pcall(function()
            if char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart:Destroy()
            else
                char:BreakJoints()
            end
        end)
    end
end

local function setupHitDetection(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if not hum then return end

    if hitDetector then hitDetector:Disconnect() end

    local currentHp = hum.Health

    hitDetector = hum.HealthChanged:Connect(function(newHp)
        if isAutoDieFrozen and newHp < currentHp and not isDying then
            triggerKillCreditDeath()
        end
        currentHp = newHp
    end)
    
    char.ChildAdded:Connect(function(child)
        if isAutoDieFrozen and not isDying and (child.Name == "Ragdoll" or child.Name == "Knockback" or child.Name == "Stun") then
            triggerKillCreditDeath()
        end
    end)
end

FreezeAutoDieBtn.MouseButton1Click:Connect(function()
    isAutoDieFrozen = not isAutoDieFrozen
    
    if isAutoDieFrozen then
        FreezeAutoDieBtn.Text = "💀 Freeze + Auto Die: ON"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        isDying = false
        
        setupHitDetection(LocalPlayer.Character)
        
        if autoDieConnection then autoDieConnection:Disconnect() end
        autoDieConnection = RunService.RenderStepped:Connect(function()
            if not isDying then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    hrp.CFrame = targetCFrame1
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    else
        FreezeAutoDieBtn.Text = "💀 Freeze + Auto Die: OFF"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        isDying = false
        
        if autoDieConnection then autoDieConnection:Disconnect() autoDieConnection = nil end
        if hitDetector then hitDetector:Disconnect() hitDetector = nil end
    end
end)

