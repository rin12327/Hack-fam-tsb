-- 3. LOGIC FREEZE (TỌA ĐỘ MỚI), 1 HP & INSTANT RESPAWN
---------------------------------------------------------
local isFrozen = false
local freezeConnection = nil

-- Tọa độ CFrame mới lấy từ ảnh của bạn
local targetCFrame = CFrame.new(
    379.810608, 442.174805, -373.177155,
    -0.134585842, -1.59712665e-09, 0.990901947,
    7.0448678e-08, 1, 1.11802398e-08,
    -0.990901947, 7.08670557e-08, -0.134585842
)

-- Hàm áp dụng máu yếu (1 HP)
local function applyLowHealth(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then
        hum.MaxHealth = 1
        hum.Health = 1
        
        -- Lắng nghe sự kiện chết để HỒI SINH NGAY LẬP TỨC 0s
        hum.Died:Connect(function()
            if isFrozen then
                task.spawn(function()
                    LocalPlayer:LoadCharacter() -- Force respawn tức thì
                end)
            end
        end)
    end
end

-- Theo dõi mỗi khi nhân vật hồi sinh lại
LocalPlayer.CharacterAdded:Connect(function(char)
    if isFrozen then
        task.wait(0.05)
        applyLowHealth(char)
    end
end)

FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    
    if isFrozen then
        FreezeBtn.Text = "❄️ Freeze (Spawn): ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        
        -- Làm yếu máu nhân vật hiện tại
        applyLowHealth(LocalPlayer.Character)
        
        -- Khóa vị trí tại tọa độ mới
        freezeConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.CFrame = targetCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    else
        FreezeBtn.Text = "❄️ Freeze (Spawn): OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        
        -- Hủy khóa vị trí
        if freezeConnection then
            freezeConnection:Disconnect()
            freezeConnection = nil
        end
        
        -- Khôi phục lại máu bình thường
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.MaxHealth = 100
            char.Humanoid.Health = 100
        end
    end
end)
