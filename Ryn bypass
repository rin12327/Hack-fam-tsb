-- 3. LOGIC FREEZE, CHẾT THẬT TRONG 1 HIT & AUTO RESPAWN 0S
---------------------------------------------------------
local isFrozen = false
local freezeConnection = nil
local hitDetectorConnection = nil

-- Tọa độ CFrame từ ảnh
local targetCFrame = CFrame.new(
    379.810608, 442.174805, -373.177155,
    -0.134585842, -1.59712665e-09, 0.990901947,
    7.0448678e-08, 1, 1.11802398e-08,
    -0.990901947, 7.08670557e-08, -0.134585842
)

-- Hàm ép chết THẬT ngay lập tức khi trúng đòn
local function setupRealOneHitDie(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    local head = char:WaitForChild("Head", 3)
    if not hum then return end

    if hitDetectorConnection then hitDetectorConnection:Disconnect() end

    -- Lắng nghe sự kiện chết để hồi sinh tức thì 0s
    hum.Died:Connect(function()
        if isFrozen then
            task.spawn(function()
                LocalPlayer:LoadCharacter() -- Respawn lập tức
            end)
        end
    end)

    -- Phát hiện khi bị đối thủ đánh trúng (Health giảm thật trên Server)
    local lastHealth = hum.Health
    hitDetectorConnection = hum.HealthChanged:Connect(function(currentHealth)
        if isFrozen and currentHealth < lastHealth then
            -- Bị dính đòn -> Ép Server tính là chết ngay lập tức bằng cách xóa Neck/Head ở client
            pcall(function()
                if head and head:FindFirstChild("Neck") then
                    head.Neck:Destroy()
                else
                    char:BreakJoints() -- Ép vỡ khớp nhân vật
                end
            end)
        end
        lastHealth = currentHealth
    end)
end

-- Tự động kích hoạt lại khi vừa hồi sinh
LocalPlayer.CharacterAdded:Connect(function(char)
    if isFrozen then
        task.wait(0.1)
        setupRealOneHitDie(char)
    end
end)

FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    
    if isFrozen then
        FreezeBtn.Text = "❄️ Freeze (Spawn): ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        
        -- Kích hoạt logic chết ngay trong 1 hit
        setupRealOneHitDie(LocalPlayer.Character)
        
        -- Khóa vị trí chuẩn tại tọa độ trong ảnh
        freezeConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                hrp.CFrame = targetCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    else
        FreezeBtn.Text = "❄️ Freeze (Spawn): OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        
        -- Hủy khóa vị trí
        if freezeConnection then freezeConnection:Disconnect() freezeConnection = nil end
        if hitDetectorConnection then hitDetectorConnection:Disconnect() hitDetectorConnection = nil end
    end
end)
