local autoSkillEnabled = false
local autoSkillThread = nil

local autoPunchSkillEnabled = false
local autoPunchSkillThread = nil

local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function performPunch()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        VirtualUser:Button1Down(Vector2.new(0, 0), Camera.CFrame)
        task.wait(0.08)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        VirtualUser:Button1Up(Vector2.new(0, 0), Camera.CFrame)
    end)
end

local function getSkill3Cooldown()
    local remaining = 0
    pcall(function()
        local hotbar = PlayerGui:FindFirstChild("Hotbar") or PlayerGui:FindFirstChild("MainGui")
        if hotbar then
            for _, slot in ipairs(hotbar:GetDescendants()) do
                if slot.Name == "3" or slot.Name == "Slot3" or string.find(slot.Name, "3") then
                    local cdText = slot:FindFirstChildOfClass("TextLabel")
                    if cdText and cdText.Visible and tonumber(cdText.Text) then
                        remaining = tonumber(cdText.Text) or 0
                    end
                end
            end
        end
    end)
    return remaining
end

local function isEnemyInvulnerable(targetChar)
    if not targetChar then return true end
    if targetChar:FindFirstChildOfClass("ForceField") then 
        return true 
    end
    return false
end

-- KIỂM TRA MỤC TIÊU CÒN SỐNG (DÙNG CHO BẮT ĐẦU VÒNG LẶP COMBO)
local function getValidTargetNear()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local targetChar = plr.Character
            local targetHrp = targetChar.HumanoidRootPart
            local targetHum = targetChar.Humanoid
            
            if targetHum.Health > 0 then
                local dist = (targetHrp.Position - myPos).Magnitude
                if dist <= 10 then
                    if not isEnemyInvulnerable(targetChar) then
                        return targetChar
                    end
                end
            end
        end
    end
    return nil
end

-- KIỂM TRA MỤC TIÊU HOẶC XÁC MỤC TIÊU (DÙNG ĐỂ TUNG TIẾP SKILL 3-4 KHI ĐÃ ĐẮM)
local function getAnyTargetOrCorpseNear()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetChar = plr.Character
            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
            
            if targetHrp then
                local dist = (targetHrp.Position - myPos).Magnitude
                if dist <= 10 then
                    return targetChar
                end
            end
        end
    end
    return nil
end

-- AUTO SKILL 1 - 2
