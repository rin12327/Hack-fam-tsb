local antiLagEnabled = false
local connections = {}
local hiddenObjects = {}
local noClipConnection = nil
local continuousCleanConnection = nil

local banKeywords = {
    "tree", "bench", "trash", "chair", "table", "bush", "grass", "cloud", 
    "rock", "prop", "destructible", "breakable", "building", "wall", "fence",
    "dash", "vfx", "fx", "aura", "slash", "particle", "eff", "impact", "shockwave",
    "smoke", "dust", "debris", "blast", "hit", "ring", "wave", "emit"
}

local function isBannedName(name)
    local lowerName = string.lower(name)
    for _, kw in ipairs(banKeywords) do
        if string.find(lowerName, kw) then return true end
    end
    return false
end

local function isCharacterObject(obj)
    if not obj then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and (obj == plr.Character or obj:IsDescendantOf(plr.Character)) then
            return true
        end
    end
    return false
end

local function createAntiVoidFloor()
    local floor = Workspace:FindFirstChild("AntiVoidSafetyFloor")
    if not floor then
        floor = Instance.new("Part")
        floor.Name = "AntiVoidSafetyFloor"
        floor.Size = Vector3.new(200000, 20, 200000)
        floor.Position = Vector3.new(0, -20, 0)
        floor.Anchored = true
        floor.CanCollide = true
        floor.Material = Enum.Material.SmoothPlastic
        floor.Transparency = 1
        floor.Parent = Workspace
    end
end

local function stripAndOptimizeCharacter(char)
    if not char then return end
    pcall(function()
        for _, child in ipairs(char:GetDescendants()) do
            if child:IsA("Accessory") or child:IsA("Accoutrement") or child:IsA("Shirt") 
               or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") 
               or child:IsA("Decal") or child:IsA("Texture") or child:IsA("ParticleEmitter")
               or child:IsA("Trail") or child:IsA("Beam") or child:IsA("Highlight") then
                child:Destroy()
            elseif child:IsA("BasePart") then
                child.Material = Enum.Material.SmoothPlastic
                child.Reflectance = 0
                child.CastShadow = false
                
                if child.Name == "Left Arm" or child.Name == "Right Arm" or child.Name == "Left Leg" or child.Name == "Right Leg"
                   or child.Name == "LeftUpperArm" or child.Name == "RightUpperArm" or child.Name == "LeftLowerArm" or child.Name == "RightLowerArm"
                   or child.Name == "LeftHand" or child.Name == "RightHand" or child.Name == "LeftUpperLeg" or child.Name == "RightUpperLeg"
                   or child.Name == "LeftLowerLeg" or child.Name == "RightLowerLeg" or child.Name == "LeftFoot" or child.Name == "RightFoot" then
                    child.Transparency = 1
                end
            end
        end
        
        local animate = char:FindFirstChild("Animate")
        if animate then animate.Disabled = true end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then animator:Destroy() end
        end
    end)
end

local function processObject(obj)
    if not obj or not antiLagEnabled then return end
    pcall(function()
        if obj.Name == "AntiVoidSafetyFloor" or obj:IsA("Camera") or obj:IsA("Terrain") then return end

        if isCharacterObject(obj) then return end

        if isBannedName(obj.Name) or obj:IsA("Clouds") or obj:IsA("Explosion") then
            obj:Destroy()
            return
        end

        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") 
            or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Highlight") 
            or obj:IsA("Beam") or obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
            return
        end

        if obj:IsA("BasePart") or obj:IsA("MeshPart") then
            if not hiddenObjects[obj] then
                hiddenObjects[obj] = {
                    Transparency = obj.Transparency,
                    Material = obj.Material,
                    CastShadow = obj.CastShadow,
                    CanCollide = obj.CanCollide
                }
            end
            obj.Material = Enum.Material.SmoothPlastic
            obj.Reflectance = 0
            obj.CastShadow = false
            obj.Transparency = 1
            obj.CanCollide = false
        end
    end)
end

local function enableAntiLag()
    antiLagEnabled = true
    createAntiVoidFloor()
    
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        Lighting.ClockTime = 12
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("Clouds") or v:IsA("Sky") or v:IsA("PostEffect") or v:IsA("Atmosphere") then 
                v:Destroy() 
            end
        end
        if Workspace.Terrain then Workspace.Terrain:Clear() end
    end)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then stripAndOptimizeCharacter(plr.Character) end
        local pConn = plr.CharacterAdded:Connect(function(char)
            if antiLagEnabled then
                task.wait(0.1)
                stripAndOptimizeCharacter(char)
            end
        end)
        table.insert(connections, pConn)
    end
    
    local plrJoinedConn = Players.PlayerAdded:Connect(function(plr)
        local pConn = plr.CharacterAdded:Connect(function(char)
            if antiLagEnabled then
                task.wait(0.1)
                stripAndOptimizeCharacter(char)
            end
        end)
        table.insert(connections, pConn)
    end)
    table.insert(connections, plrJoinedConn)

    for _, v in ipairs(Workspace:GetDescendants()) do processObject(v) end
    
    local conn = Workspace.DescendantAdded:Connect(function(child)
        if antiLagEnabled then task.spawn(function() processObject(child) end) end
    end)
    table.insert(connections, conn)

    if continuousCleanConnection then continuousCleanConnection:Disconnect() end
    continuousCleanConnection = RunService.RenderStepped:Connect(function()
        if antiLagEnabled then
            for _, obj in ipairs(Workspace:GetChildren()) do
                if not isCharacterObject(obj) and obj.Name ~= "AntiVoidSafetyFloor" and not obj:IsA("Camera") and not obj:IsA("Terrain") then
                    if isBannedName(obj.Name) or obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Highlight") or obj:IsA("Beam") then
                        obj:Destroy()
                    end
                end
            end
        end
    end)

    if noClipConnection then noClipConnection:Disconnect() end
    noClipConnection = RunService.Stepped:Connect(function()
        if antiLagEnabled and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch = false
                end
            end
        end
    end)
end

local function disableAntiLag()
    antiLagEnabled = false
    for _, conn in ipairs(connections) do conn:Disconnect() end
    connections = {}
    
    if noClipConnection then noClipConnection:Disconnect() noClipConnection = nil end
    if continuousCleanConnection then continuousCleanConnection:Disconnect() continuousCleanConnection = nil end

    for obj, data in pairs(hiddenObjects) do
        if obj and obj.Parent then
            pcall(function()
                obj.Transparency = data.Transparency
                obj.Material = data.Material
                obj.CastShadow = data.CastShadow
                obj.CanCollide = data.CanCollide
            end)
        end
    end
    hiddenObjects = {}
    local floor = Workspace:FindFirstChild("AntiVoidSafetyFloor")
    if floor then floor:Destroy() end
end

AntiLagBtn.MouseButton1Click:Connect(function()
    if not antiLagEnabled then
        enableAntiLag()
        AntiLagBtn.Text = "⚡ Anti-Lag + NoClip: ON"
        AntiLagBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
    else
        disableAntiLag()
        AntiLagBtn.Text = "💥 Anti-Lag + NoClip: OFF"
        AntiLagBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

