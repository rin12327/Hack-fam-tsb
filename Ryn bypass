-- 3. LOGIC FREEZE (TỌA ĐỘ MỚI TỪ ẢNH) & KILL CREDIT
---------------------------------------------------------
local isFrozen = false
local freezeConnection = nil
local hitDetector = nil
local isDying = false

-- Tọa độ CFrame MỚI CẬP NHẬT từ ảnh
local targetCFrame = CFrame.new(
    439.180542, 439.511902, -375.309557,
    0.736803472, -4.96859727e-08, 0.676106989,
    -3.74575819e-08, 1, 1.14308612e-07,
    -0.676106989, -1.09542017e-07, 0.736803472
)

local function triggerKillCreditDeath()
    if isDying then return end
    isDying = true

    if freezeConnection then
        freezeConnection:Disconnect()
        freezeConnection = nil
    end

    task.wait(0.02)

    local char = LocalPlayer.Character
    if char then
        pcall(function()
            if char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart:Destroy()
            else
                char:BreakJoints()
            end
        end)
    end
end

local function setupHitDetection(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if not hum then return end

    if hitDetector then hitDetector:Disconnect() end

    local currentHp = hum.Health

    hitDetector = hum.HealthChanged:Connect(function(newHp)
        if isFrozen and newHp < currentHp and not isDying then
            triggerKillCreditDeath()
        end
        currentHp = newHp
    end)
    
    char.ChildAdded:Connect(function(child)
        if isFrozen and not isDying and (child.Name == "Ragdoll" or child.Name == "Knockback" or child.Name == "Stun") then
            triggerKillCreditDeath()
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    isDying = false
    
    if isFrozen then
        task.wait(0.05)
        setupHitDetection(char)
        
        if not freezeConnection then
            freezeConnection = RunService.RenderStepped:Connect(function()
                if not isDying then
                    local curChar = LocalPlayer.Character
                    if curChar and curChar:FindFirstChild("HumanoidRootPart") then
                        local hrp = curChar.HumanoidRootPart
                        hrp.CFrame = targetCFrame
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end)
        end
    end
end)

FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    
    if isFrozen me
        FreezeBtn.Text = "❄️ Freeze (Spawn): ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        isDying = false
        
        setupHitDetection(LocalPlayer.Character)
        
        if freezeConnection then freezeConnection:Disconnect() end
        freezeConnection = RunService.RenderStepped:Connect(function()
            if not isDying then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    hrp.CFrame = targetCFrame
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    else
        FreezeBtn.Text = "❄️ Freeze (Spawn): OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        isDying = false
        
        if freezeConnection then freezeConnection:Disconnect() freezeConnection = nil end
        if hitDetector then hitDetector:Disconnect() hitDetector = nil end
    end
end)
