local function pressKey(keyCode)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

local function spamKey(keyCode, duration)
    local startTime = tick()
    while tick() - startTime < duration do
        pressKey(keyCode)
        task.wait(0.05)
    end
end

local function performPunch()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function getValidAliveTarget()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myChar.HumanoidRootPart.Position

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local targetChar = plr.Character
            local hum = targetChar:FindFirstChildOfClass("Humanoid")
            local hrp = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("Torso")
            
            if hum and hum.Health > 0 and hrp and not targetChar:FindFirstChildOfClass("ForceField") then
                if (hrp.Position - myPos).Magnitude <= 12 then
                    return targetChar
                end
            end
        end
    end
    return nil
end

