-- AUTO COMBO 3-4: ĐẤM TRƯỚC 2S CHIÊU 3, VẪN CHO PHÉP TUNG SKILL VÀO XÁC KHI ĐỐI THỦ CHẾT
local function startAutoPunchSkillLoop()
    autoPunchSkillThread = task.spawn(function()
        while autoPunchSkillEnabled do
            task.wait(0.05)
            local target = getValidTargetNear()
            if target then
                local cd3 = getSkill3Cooldown()
                
                if cd3 <= 2 then
                    performPunch()
                    
                    if cd3 > 0 then
                        task.wait(cd3)
                    else
                        task.wait(0.35)
                    end
                    
                    -- KIỂM TRA NỐI SKILL: BỎ QUA KIỂM TRA MÁU (XÁC CÒN Ở ĐÓ VẪN CHO TUNG CHIÊU)
                    local corpseTarget1 = getAnyTargetOrCorpseNear()
                    if corpseTarget1 then
                        pressKey(Enum.KeyCode.Three)
                        task.wait(0.3)
                    end
                    
                    local corpseTarget2 = getAnyTargetOrCorpseNear()
                    if corpseTarget2 then
                        pressKey(Enum.KeyCode.Four)
                        task.wait(0.3)
