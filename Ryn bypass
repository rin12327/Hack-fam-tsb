-- 3A. FREEZE AUTO DIE (CHỈ SỬA -200 HOẶC KHI DÍNH CHIÊU GAROU)
local isAutoDieFrozen = false
local autoDieConnection = nil
local lastHealth = 100
local isDying = false

local function triggerInstantVoidDeath()
    if isDying then return end
    isDying = true
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = char.HumanoidRootPart
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            -- Nhảy xuống Void ở Y = -200 theo đúng yêu cầu
            hrp.CFrame = CFrame.new(hrp.Position.X, -200, hrp.Position.Z)
        end)
    end
end

-- Kiểm tra xem nhân vật có bị dính chiêu Garou/Combo tóm hay không
local function isHitByGarouOrCombo(char)
    if not char then return false end
    return char:FindFirstChild("Ragdoll") or char:FindFirstChild("Stun") or char:FindFirstChild("Knockback")
        or char:FindFirstChild("Grabbed") or char:FindFirstChild("BeingGrabbed") 
        or char:FindFirstChild("Combo") or char:FindFirstChild("Action")
end

FreezeAutoDieBtn.MouseButton1Click:Connect(function()
    isAutoDieFrozen = not isAutoDieFrozen
    if isAutoDieFrozen then
        FreezeAutoDieBtn.Text = "💀 Freeze + Auto Die: ON"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        isDying = false
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            lastHealth = char.Humanoid.Health
        end
        
        if autoDieConnection then autoDieConnection:Disconnect() end
        
        -- Chuyển sang RenderStepped để khóa vị trí liên tục từng Frame, không bị văng đi khi trúng đòn
        autoDieConnection = RunService.RenderStepped:Connect(function()
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("HumanoidRootPart") and curChar:FindFirstChild("Humanoid") then
                local hum = curChar.Humanoid
                local hrp = curChar.HumanoidRootPart
                
                -- NẾU MẤT BẤT KỲ LƯỢNG MÁU NÀO DÙ LÀ 0.01 HP -> TELEPORT VOID -200 NGAY
                if hum.Health < lastHealth then
                    triggerInstantVoidDeath()
                end
                lastHealth = hum.Health
                
                -- KIỂM TRA DÍNH CHIÊU GAROU/STUN/RAGDOLL/COMBO -> TỰ ĐỘNG CHẾT NGAY
                if isHitByGarouOrCombo(curChar) then
                    triggerInstantVoidDeath()
                end

                -- GIỮ VỊ TRÍ NẾU CHƯA BỊ ĐÁNH & KHÓA CỨNG VẬN TỐC
                if not isDying then
                    hrp.CFrame = targetCFrame1
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    else
        FreezeAutoDieBtn.Text = "💀 Freeze + Auto Die: OFF"
        FreezeAutoDieBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        isDying = false
        if autoDieConnection then autoDieConnection:Disconnect() autoDieConnection = nil end
    end
end)

