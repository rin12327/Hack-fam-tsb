-- 4. ANTI-LAG
---------------------------------------------------------
local antiLagEnabled = false
local cleanupThread = nil
AntiLagBtn.MouseButton1Click:Connect(function()
    antiLagEnabled = not antiLagEnabled
    if antiLagEnabled then
        Lighting.GlobalShadows = false; Lighting.ClockTime = 0; Lighting.FogEnd = 9e9
        AntiLagBtn.Text = "⚡ Purge + Dark: ON"; AntiLagBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        cleanupThread = task.spawn(function()
            while antiLagEnabled do
                task.wait(0.5)
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") and not v:IsDescendantOf(LocalPlayer.Character) then
                        if v.Name:lower():find("tree") or v.Name:lower():find("prop") then v:Destroy()
                        elseif v.Transparency < 1 then v.Transparency = 1; v.CanCollide = false end
                    end
                end
            end
        end)
    else
        if cleanupThread then task.cancel(cleanupThread) end
        AntiLagBtn.Text = "💥 Anti-Lag + Dark: OFF"; AntiLagBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

