            idledConn = nil
        end
        if antiAfkThread then
            task.cancel(antiAfkThread)
            antiAfkThread = nil
        end
    end
end)

---------------------------------------------------------
-- 7. TỰ ĐỘNG BẬT LẠI KHI HỒI SINH
---------------------------------------------------------
LocalPlayer.CharacterAdded:Connect(function(char)
    isDying = false
    
    local hum = char:WaitForChild("Humanoid", 3)
    if hum then Camera.CameraSubject = hum end
    
    setupHealthTracker(char)
    
    if antiLagEnabled then
        task.wait(0.1)
        stripAndOptimizeCharacter(char)
    end
    
    if isAutoDieFrozen then
        task.wait(0.05)
        if autoDieConnection then autoDieConnection:Disconnect() end
        autoDieConnection = RunService.RenderStepped:Connect(function()
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("HumanoidRootPart") and curChar:FindFirstChild("Humanoid") then
                local curHum = curChar.Humanoid
                local hrp = curChar.HumanoidRootPart
                
                if curHum.Health < lastHealth then
                    triggerInstantVoidDeath()
                end
                
                if curChar:FindFirstChild("Ragdoll") or curChar:FindFirstChild("Stun") 
                    or curChar:FindFirstChild("Knockback") or curChar:FindFirstChild("Grabbed") 
                    or curChar:FindFirstChild("BeingGrabbed") then
                    triggerInstantVoidDeath()
                end

                if not isDying then
                    hrp.CFrame = targetCFrame1
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end
    
    if isPureFrozen then
        if pureFreezeConnection then pureFreezeConnection:Disconnect() end
        pureFreezeConnection = RunService.RenderStepped:Connect(function()
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("HumanoidRootPart") then
                local hrp = curChar.HumanoidRootPart
                hrp.CFrame = targetCFrame2
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
end)
