local antiLagActive = false
AntiLagBtn.MouseButton1Click:Connect(function()
    antiLagActive = not antiLagActive
    if antiLagActive then
        AntiLagBtn.Text = "💥 Anti-Lag: ON"
        AntiLagBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        pcall(function()
            Lighting.GlobalShadows = false
            for _, v in ipairs(Workspace:GetChildren()) do
                if v:IsA("BasePart") and not v:IsDescendantOf(LocalPlayer.Character) then
                    v.Material = Enum.Material.SmoothPlastic
                end
            end
        end)
    else
        AntiLagBtn.Text = "💥 Anti-Lag: OFF"
        AntiLagBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
    end
end)

local antiAfkActive = false
local idledConn = nil

AntiAfkBtn.MouseButton1Click:Connect(function()
    antiAfkActive = not antiAfkActive
    if antiAfkActive then
        AntiAfkBtn.Text = "⏰ Anti-AFK: ON"
        AntiAfkBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        if not idledConn then
            idledConn = LocalPlayer.Idled:Connect(function()
                if antiAfkActive then
                    VirtualUser:Button2Down(Vector2.new(0, 0), Camera.CFrame)
                    task.wait(1)
                    VirtualUser:Button2Up(Vector2.new(0, 0), Camera.CFrame)
                end
            end)
        end
    else
        AntiAfkBtn.Text = "⏰ Anti-AFK: OFF"
        AntiAfkBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if idledConn then
            idledConn:Disconnect()
            idledConn = nil
        end
    end
end)
