-- 5. FREEZE & VOID DIE LOGIC
---------------------------------------------------------
local targetCFrame1 = CFrame.new(439.18, 439.51, -375.31) * CFrame.Angles(0, math.rad(90), 0)
local targetCFrame2 = CFrame.new(437.82, 439.51, -376.99) * CFrame.Angles(0, math.rad(90), 0)
local isAutoDieFrozen, autoDieConnection, isDying = false, nil, false

local function triggerInstantVoidDeath()
    if isDying then return end
    isDying = true
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position.X, -1000, char.HumanoidRootPart.Position.Z)
        if char:FindFirstChildOfClass("Humanoid") then char.Humanoid.Health = 0 end
    end
end

FreezeAutoDieBtn.MouseButton1Click:Connect(function()
    isAutoDieFrozen = not isAutoDieFrozen
    FreezeAutoDieBtn.Text = isAutoDieFrozen and "💀 Freeze + Die: ON" or "💀 Freeze + Die: OFF"
    FreezeAutoDieBtn.BackgroundColor3 = isAutoDieFrozen and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(180, 50, 50)
    if isAutoDieFrozen then
        autoDieConnection = RunService.RenderStepped:Connect(function()
            local curChar = LocalPlayer.Character
            if curChar and curChar:FindFirstChild("HumanoidRootPart") then
                curChar.HumanoidRootPart.CFrame = targetCFrame1
                curChar.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    else
        if autoDieConnection then autoDieConnection:Disconnect() end
    end
end)

