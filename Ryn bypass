-- 4. LOGIC AUTO SKILL 1 - 2 - 3 (KIỂM TRA BẤT TỬ NGHIÊM NGẶT)
---------------------------------------------------------
local autoSkillEnabled = false
local autoSkillThread = nil

local function executeSkillSlot(slotNumber, keyCode)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    pcall(function()
        local tools = {}
        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") then table.insert(tools, item) end
            end
        end
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then table.insert(tools, item) end
            end
        end
        
        local targetTool = tools[slotNumber]
        if targetTool then
            if char and targetTool.Parent ~= char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then hum:EquipTool(targetTool) end
            end
            task.wait(0.02)
            targetTool:Activate()
        end
    end)

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- HÀM CHECK BẤT TỬ CHUẨN XÁC CỦA TSB
local function isTargetInvulnerable(targetChar)
    if not targetChar then return true end
    
    -- 1. Kiểm tra ForceField của Roblox
    if targetChar:FindFirstChildOfClass("ForceField") then return true end
    
    -- 2. Kiểm tra các Folder/Value/Tag Spawn Protection của TSB
    local invulnKeywords = {"spawnprotection", "invulnerable", "protection", "invincible", "safezone", "godmode"}
    for _, child in ipairs(targetChar:GetChildren()) do
        local childName = string.lower(child.Name)
        for _, keyword in ipairs(invulnKeywords) do
            if string.find(childName, keyword) then
                return true
            end
        end
    end
    
    -- 3. Kiểm tra Highlight (hiệu ứng lóe sáng khi vừa spawn/bất tử)
    for _, v in ipairs(targetChar:GetChildren()) do
        if v:IsA("Highlight") and v.Enabled then
            local hName = string.lower(v.Name)
            if string.find(hName, "shield") or string.find(hName, "spawn") or string.find(hName, "protect") then
                return true
            end
        end
    end
    
    return false
end

local function getValidTargetNear()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return nil end
    
    local myHrp = myChar.HumanoidRootPart
    local myPos = myHrp.Position
    local myLookVector = myHrp.CFrame.LookVector

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") then
            local targetChar = plr.Character
            local targetHrp = targetChar.HumanoidRootPart
            local targetHum = targetChar.Humanoid
            
            if targetHum.Health > 0 then
                local directionToTarget = (targetHrp.Position - myPos)
                local dist = directionToTarget.Magnitude
                
                if dist <= 35 then
                    local dot = myLookVector:Dot(directionToTarget.Unit)
                    if dot > 0.1 then 
                        -- CHỈ TRẢ VỀ MỤC TIÊU KHI ĐÃ MẤT BẤT TỬ 100%
                        if not isTargetInvulnerable(targetChar) then
                            return targetChar
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function startAutoSkillLoop()
    autoSkillThread = task.spawn(function()
        while autoSkillEnabled do
            task.wait(0.05) -- Quét liên tục mỗi 0.05s
            
            local validTarget = getValidTargetNear()
            if validTarget then
                -- Tung Skill 1
                executeSkillSlot(1, Enum.KeyCode.One)
                task.wait(0.25)
                
                -- Tung Skill 2
                executeSkillSlot(2, Enum.KeyCode.Two)
                task.wait(0.25)
                
                -- Tung Skill 3
                executeSkillSlot(3, Enum.KeyCode.Three)
                task.wait(0.4)
            end
        end
    end)
end

AutoSkillBtn.MouseButton1Click:Connect(function()
    autoSkillEnabled = not autoSkillEnabled
    
    if autoSkillEnabled then
        AutoSkillBtn.Text = "⚔️ Auto Skill 1-2-3: ON"
        AutoSkillBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        startAutoSkillLoop()
    else
        AutoSkillBtn.Text = "⚔️ Auto Skill 1-2-3: OFF"
        AutoSkillBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        if autoSkillThread then
            task.cancel(autoSkillThread)
            autoSkillThread = nil
        end
    end
end)

