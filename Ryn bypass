-- 3. LOGIC FREEZE & DỊCH CHUYỂN VOID CHẾT LẬP TỨC
---------------------------------------------------------
local isFrozen = false
local freezeConnection = nil
local hitDetector = nil
local isDyingInVoid = false

-- Tọa độ CFrame từ ảnh của bạn
local targetCFrame = CFrame.new(
    379.810608, 442.174805, -373.177155,
    -0.134585842, -1.59712665e-09, 0.990901947,
    7.0448678e-08, 1, 1.11802398e-08,
    -0.990901947, 7.08670557e-08, -0.134585842
)

-- Hàm ép rơi Void chết ngay lập tức
local function sendToVoid()
    if isDyingInVoid then return end
    isDyingInVoid = true
    
    -- 1. Hủy ngay lập tức sàn chống rơi Void để không bị vướng
    removeAntiVoidFloor()
    
    -- 2. Tắt ngắt tạm thời vòng lặp khóa CFrame
    if freezeConnection then
        freezeConnection:Disconnect()
        freezeConnection = nil
    end
    
    -- 3. Teleport thẳng nhân vật xuống cực sâu dưới Void (Y = -2000)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(0, -2000, 0)
        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, -500, 0) -- Ép vận tốc rơi nhanh
    end
end

local function setupHitDetection(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 3)
    if not hum then return end

    if hitDetector then hitDetector:Disconnect() end

    local currentHp = hum.Health

    -- Phát hiện khi bị mất máu -> Dịch chuyển xuống Void
    hitDetector = hum.HealthChanged:Connect(function(newHp)
        if isFrozen and newHp < currentHp and not isDyingInVoid then
            sendToVoid()
        end
        currentHp = newHp
    end)
    
    -- Phát hiện trạng thái Ragdoll/Knockback -> Dịch chuyển xuống Void
    char.ChildAdded:Connect(function(child)
        if isFrozen and not isDyingInVoid and (child.Name == "Ragdoll" or child.Name == "Knockback" or child.Name == "Stun") then
            sendToVoid()
        end
    end)
end

-- Vòng lặp liên tục khi HỒI SINH
LocalPlayer.CharacterAdded:Connect(function(char)
    isDyingInVoid = false
    
    -- Nếu Anti-Lag đang bật thì dựng lại sàn chống Void cho map
    if antiLagEnabled then
        task.wait(0.05)
        createAntiVoidFloor()
    end
    
    -- Nếu Freeze đang bật thì đưa về lại tọa độ Freeze và tiếp tục theo dõi
    if isFrozen then
        task.wait(0.05)
        setupHitDetection(char)
        
        if not freezeConnection then
            freezeConnection = RunService.RenderStepped:Connect(function()
                if not isDyingInVoid then
                    local curChar = LocalPlayer.Character
                    if curChar and curChar:FindFirstChild("HumanoidRootPart") then
                        local hrp = curChar.HumanoidRootPart
                        hrp.CFrame = targetCFrame
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end)
        end
    end
end)

FreezeBtn.MouseButton1Click:Connect(function()
    isFrozen = not isFrozen
    
    if isFrozen then
        FreezeBtn.Text = "❄️ Freeze (Spawn): ON"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        isDyingInVoid = false
        
        setupHitDetection(LocalPlayer.Character)
        
        if freezeConnection then freezeConnection:Disconnect() end
        freezeConnection = RunService.RenderStepped:Connect(function()
            if not isDyingInVoid then
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    hrp.CFrame = targetCFrame
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    else
        FreezeBtn.Text = "❄️ Freeze (Spawn): OFF"
        FreezeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        isDyingInVoid = false
        
        if freezeConnection then freezeConnection:Disconnect() freezeConnection = nil end
        if hitDetector then hitDetector:Disconnect() hitDetector = nil end
        
        -- Khôi phục lại sàn chống Void nếu Anti-Lag đang mở
        if antiLagEnabled then createAntiVoidFloor() end
    end
end)
